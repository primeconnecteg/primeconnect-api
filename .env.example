# ==========================================
# Application Configuration
# ==========================================
PROJECT_NAME=PrimeConnect API
VERSION=1.0.0

# The domains of your frontend. This configures CORS so the browser allows requests.
# Format as a JSON array string.
BACKEND_CORS_ORIGINS=["https://primeconnect.com", "http://localhost:3000"]

# ==========================================
# Security
# ==========================================
# Critical: Generate a strong key using `openssl rand -hex 32` for production!
SECRET_KEY=change_this_to_a_long_random_string_in_production

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=primeconnect_admin
POSTGRES_PASSWORD=super_secure_db_password
# In Docker Compose, the server name equals the service name ("postgres")
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=primeconnect

# ==========================================
# Email Configuration (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=True
SMTP_FROM_NAME=PrimeConnect
SMTP_FROM_EMAIL=your_email@gmail.com
CEO_EMAIL=ceo@primeconnect.com

# ==========================================
# Initial Administrator Account
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_initial_password
